Options -Indexes
Options -MultiViews

DirectoryIndex index.html

ErrorDocument 403 /403.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve Eleventy directory pages when the trailing slash is omitted.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+?)/?$ $1/index.html [END]
</IfModule>

# Deployment metadata must never be served from the public release.
<FilesMatch "^(branch|build|deployment)\.json$">
    Require all denied
</FilesMatch>
